<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        AI budgets & fair use (v19.0.7.0.0).

        Layout follows the constraints documented in ai_agent_views.xml:
        flat groups, no embedded lists inside a field, no colspan.
    -->

    <record id="view_daadit_ai_budget_list" model="ir.ui.view">
        <field name="name">daadit.ai.budget.list</field>
        <field name="model">daadit.ai.budget</field>
        <field name="arch" type="xml">
            <list decoration-danger="usage_ratio &gt;= 1"
                  decoration-warning="usage_ratio &gt;= 0.6 and usage_ratio &lt; 1">
                <field name="name"/>
                <field name="scope"/>
                <field name="agent_id"/>
                <field name="company_id"/>
                <field name="daily_cap_usd" sum="Daily cap"/>
                <field name="spend_today_usd" sum="Spent today"/>
                <field name="monthly_cap_usd" sum="Monthly cap"/>
                <field name="spend_month_usd" sum="Spent this month"/>
                <field name="usage_ratio" widget="percentage"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_daadit_ai_budget_form" model="ir.ui.view">
        <field name="name">daadit.ai.budget.form</field>
        <field name="model">daadit.ai.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="scope"/>
                        <field name="agent_id"
                               invisible="scope != 'agent'"
                               required="scope == 'agent'"/>
                        <field name="company_id"
                               invisible="scope != 'company'"
                               required="scope == 'company'"/>
                        <field name="active"/>
                    </group>
                    <group string="Budget (USD)">
                        <field name="daily_cap_usd"/>
                        <field name="monthly_cap_usd"/>
                        <field name="warn_ratio"/>
                        <field name="notify_email"
                               placeholder="nick@daadit.group"/>
                    </group>
                    <group string="Current spend (all providers)">
                        <field name="spend_today_usd"/>
                        <field name="spend_month_usd"/>
                        <field name="usage_ratio" widget="percentage"/>
                    </group>
                    <div>
                        <p class="text-muted">
                            Below the warning threshold nothing happens.
                            From the threshold the user gets one
                            fair-use notice per day in the chat. At 100%
                            the agent is paused until the budget resets
                            — daily budgets at local midnight, monthly
                            budgets on the 1st.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_daadit_ai_budget" model="ir.actions.act_window">
        <field name="name">AI Budgets &amp; Fair Use</field>
        <field name="res_model">daadit.ai.budget</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
