<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_daadit_ai_mistral" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.daadit_ai_mistral</field>
        <field name="model">res.config.settings</field>
        <!--
            Odoo 20: ``ai_app`` bestaat niet meer en de module ``ai``
            levert geen eigen instellingenview (geverifieerd: alleen
            ai_mcp en ai_website hebben er een). We hangen daarom een
            eigen <app>-blok aan de basisview, die altijd bestaat.

            Layout binnen de <setting> is ongewijzigd: toggle + key
            volgens het stock-patroon (flex-grow-1 div met nolabel
            veld), geavanceerde velden in een binnenste <group>.

            De hulpkaart met stappen voor ChatGPT en Gemini is
            vervallen: die verwees naar velden van ai_app ("Use your
            own ChatGPT account") die op Odoo 20 niet meer bestaan. De
            Mistral-stappen staan nu in de setting zelf.
        -->
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <app data-string="Mistral AI" string="Mistral AI"
                     name="daadit_ai_mistral"
                     logo="/daadit_ai_mistral/static/description/icon.png"
                     groups="base.group_system">
                    <block title="Mistral AI" name="daadit_ai_mistral_provider">
                        <setting id="mistral_provider"
                                 string="Use your own Mistral AI account"
                                 help="Provide your API key to connect with your account"
                                 groups="base.group_system">
                            <field name="mistral_key_enabled"/>
                            <div invisible="not mistral_key_enabled">
                                <div class="flex-grow-1">
                                    <field name="mistral_key"
                                           placeholder="Key"
                                           password="True"
                                           nolabel="1"
                                           class="w-100"/>
                                </div>
                                <div class="mt8">
                                    <label for="mistral_key_batch"
                                           string="Aparte key voor geplande agents (batch)"/>
                                    <field name="mistral_key_batch"
                                           placeholder="Optioneel — leeg = zelfde key"
                                           password="True"
                                           nolabel="1"
                                           class="w-100"/>
                                    <div class="text-muted">
                                        Geplande agent-runs gebruiken deze key
                                        zodat batch-verkeer de livechat-key
                                        nooit kan leegtrekken (Fase 0).
                                    </div>
                                </div>
                                <div class="text-muted mt8 mb8">
                                    <i class="fa fa-info-circle me-1"/>
                                    Get a key at
                                    <a href="https://console.mistral.ai/api-keys/"
                                       target="_blank" rel="noopener">console.mistral.ai/api-keys</a>
                                    (sign in → add a billing method →
                                    <strong>Create new key</strong> → copy the value
                                    shown once). Mistral requires a payment method
                                    under <strong>Workspace → Billing</strong>
                                    before it issues API keys.
                                </div>
                                <group>
                                    <field name="mistral_base_url" string="API base URL"/>
                                    <field name="mistral_timeout" string="Request timeout (s)"/>
                                </group>
                                <div class="mt8">
                                    <button type="object"
                                            name="action_daadit_mistral_sync_models"
                                            string="Refresh Mistral model list"
                                            icon="fa-refresh"
                                            class="btn-secondary"/>
                                    <div class="text-muted mt4">
                                        <i class="fa fa-info-circle me-1"/>
                                        The available Mistral models are synced
                                        automatically every day from the Mistral API.
                                        Use this button to refresh now (save the key
                                        first). Manage the list under
                                        <strong>Mistral Models</strong>.
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
