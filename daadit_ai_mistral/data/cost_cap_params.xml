<?xml version="1.0" encoding="utf-8"?>
<!--
    Daily cost-cap defaults (v19.0.4.3.0).

    noupdate="1": these are seed values. Once set, admins tune them in
    Settings -> Technical -> System Parameters without a module upgrade
    reverting the change.

    - daily_cost_cap_usd = 5  -> hard daily budget in USD (Mistral bills
      in USD; ~EUR 4.6). 0 would disable the cap.
    - cost_cap_notify_email    -> left empty here; set to the admin's
      address (e.g. nick@daadit.group) so the "budget reached" mail has
      a recipient. Empty falls back to the admin user / company e-mail.
-->
<odoo>
    <data noupdate="1">
        <record id="cost_cap_daily_usd" model="ir.config_parameter">
            <field name="key">daadit_ai_mistral.daily_cost_cap_usd</field>
            <field name="value">5</field>
        </record>
        <record id="cost_cap_notify_email" model="ir.config_parameter">
            <field name="key">daadit_ai_mistral.cost_cap_notify_email</field>
            <field name="value"></field>
        </record>
    </data>
</odoo>
